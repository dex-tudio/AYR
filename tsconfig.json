{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "moduleSuffixes": [".ios", ".web", ""],
    "allowImportingTsExtensions": true,
    "types": ["node", "react"]
  },
  "include": ["app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "playwright.config.ts", "tests/**/*.ts"]
}
